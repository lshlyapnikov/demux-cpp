{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) demultiplexer_test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/demultiplexer_test",
            //"coreDumpPath": "${workspaceFolder}/core.latest",
            "args": [
                // "--gtest_filter=NonBlockingDemuxWriterTest.WriteWhenBufferIfFullAndGetWriteRepeatResult"
                // "--gtest_filter=*BlockingDemuxWriterTest.OneReaderReadX"
                "--gtest_filter=NonBlockingDemuxWriterTest.OneReaderReadX"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}