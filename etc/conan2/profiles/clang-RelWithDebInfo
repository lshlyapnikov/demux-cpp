# code: language=toml
# cspell:disable
# shellcheck disable=all

include(clang-Common)

[settings]
build_type=RelWithDebInfo

[conf]
# gperftools needs `-gdwarf-4 -03 -DNDEBUG`
tools.build:cxxflags=["-gdwarf-4", "-fdebug-default-version=4", "-O3", "-DNDEBUG"]
tools.build:cflags=["-gdwarf-4", "-fdebug-default-version=4", "-O3", "-DNDEBUG"]
