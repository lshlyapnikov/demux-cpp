# code: language=toml
# cspell:disable
# shellcheck disable=all

include(clang-Common)

[settings]
build_type=RelWithDebInfo

[conf]
# gperftools needs `-gdwarf-4 -03 -DNDEBUG`
tools.build:cxxflags=["-g", "-O3", "-DNDEBUG", "-fno-omit-frame-pointer",]
tools.build:cflags=["-g", "-O3", "-DNDEBUG", "-fno-omit-frame-pointer",]
tools.build:sharedlinkflags=["-rdynamic"]
tools.build:exelinkflags=["-rdynamic"]
