# code: language=toml
# cspell:disable
# shellcheck disable=all

include(clang-Common)

[settings]
build_type=Debug

[conf]
## Default settings
#tools.build:cxxflags=["-g", "-O0", "-fno-omit-frame-pointer"]
#tools.build:cflags=["-g", "-O0", "-fno-omit-frame-pointer"]
#
## ASan and MSan, performs much better and more reliably when compiled with a minimal level of optimization (-O1).
#
## ASan(address) + UBSan(undefined) + LSan(leak)
tools.build:cxxflags=["-g", "-O0", "-fno-omit-frame-pointer", "-fsanitize=address,undefined,leak"]
tools.build:cflags=["-g", "-O0", "-fno-omit-frame-pointer", "-fsanitize=address,undefined,leak"]
tools.build:sharedlinkflags=["-rdynamic", "-fsanitize=address,undefined,leak"]
tools.build:exelinkflags=["-rdynamic", "-fsanitize=address,undefined,leak"]
#
## MSan(memory) -- didn't work, looks like GTest doesn't pick up the MSan settings
